{
  "name": "@okr/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate deploy",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "account:link": "tsx src/accounts/issue-link.ts",
    "platform:bootstrap": "tsx src/platform/bootstrap-command.ts",
    "operations:check": "tsx src/operations/check-command.ts",
    "mail:status": "tsx src/accounts/mail-status.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@okr/shared": "1.0.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.2",
    "nodemailer": "^10.0.14",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.0"
  }
}
