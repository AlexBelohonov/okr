#!/bin/bash
set -Eeuo pipefail
umask 077
export AWS_DEFAULT_REGION='${region}'
dnf install -y docker awscli-2 unzip python3 xfsprogs openssl
systemctl enable --now docker amazon-ssm-agent
install -d -m 755 /usr/local/lib/docker/cli-plugins
work=$(mktemp -d)
cd "$work"
curl --fail --location --retry 5 --silent --show-error \
  'https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64' -o docker-compose
curl --fail --location --retry 5 --silent --show-error \
  'https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64.sha256' -o compose.sha256
echo "$(awk '{print $1}' compose.sha256)  docker-compose" | sha256sum --check --status
install -m 755 docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
curl --fail --location --retry 5 --silent --show-error \
  'https://github.com/docker/buildx/releases/download/${buildx_version}/buildx-${buildx_version}.linux-amd64' -o docker-buildx
curl --fail --location --retry 5 --silent --show-error \
  'https://github.com/docker/buildx/releases/download/${buildx_version}/checksums.txt' -o buildx.sha256
awk '$2 == "buildx-${buildx_version}.linux-amd64" {print $1 "  docker-buildx"}' buildx.sha256 > buildx.selected
test -s buildx.selected
sha256sum --check --status buildx.selected
install -m 755 docker-buildx /usr/local/lib/docker/cli-plugins/docker-buildx
docker compose version
docker buildx version
aws s3 cp 's3://${bucket}/${release_key}' release.zip --only-show-errors
echo '${release_sha256}  release.zip' | sha256sum --check --status
install -d -m 700 /opt/okr
unzip -q release.zip -d /opt/okr/app
printf '%s' '${config_b64}' | base64 --decode > /etc/okr-deploy.json
chmod 600 /etc/okr-deploy.json
install -m 700 /opt/okr/app/infra/terraform/ec2/bootstrap.sh /usr/local/sbin/okr-bootstrap
/usr/local/sbin/okr-bootstrap
